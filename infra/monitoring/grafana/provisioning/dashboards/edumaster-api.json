{
  "title": "EduMaster API",
  "uid": "edumaster-api",
  "schemaVersion": 39,
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    { "type": "timeseries", "title": "Solicitudes por segundo", "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [{ "expr": "sum(rate(http_requests_total[1m])) by (handler)" }] },
    { "type": "timeseries", "title": "Latencia p95 (s)", "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "targets": [{ "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le, handler))" }] },
    { "type": "timeseries", "title": "Tasa de error 5xx", "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "targets": [{ "expr": "sum(rate(http_requests_total{status=\"5xx\"}[5m]))" }] }
  ]
}
