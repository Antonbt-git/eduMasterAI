# =====================================================================
# EduMaster.ai — variables de entorno (copiar a .env y completar)
# Genera secretos fuertes con:  ./scripts/gen-secrets.sh >> .env
# NUNCA subas el archivo .env al repositorio.
# =====================================================================
ENVIRONMENT=local
PUBLIC_WEB_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# --- PostgreSQL local (docker compose) ---
POSTGRES_DB=edumaster
POSTGRES_USER=edumaster
POSTGRES_PASSWORD=cambia-esta-clave

# --- Seguridad (OBLIGATORIO cambiar) ---
JWT_SECRET=cambia-por-64-caracteres-aleatorios
INTERNAL_SERVICE_TOKEN=cambia-por-token-interno-aleatorio
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# --- Datos y comportamiento DEMO ---
SEED_DEMO_DATA=true
DEMO_SIMULATOR=true
BOOTSTRAP_TRAINING=true
DEMO_PASSWORD=EduMaster#2026

# --- IA Tutor con API externa (opcional) ---
# AI_TUTOR_PROVIDER: none | anthropic | openai
AI_TUTOR_PROVIDER=none
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Cualquier API compatible con OpenAI (OpenAI, Groq, Together, OpenRouter, Ollama...)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# --- Supabase (opcional; ver docs/DEPLOY_SUPABASE.md) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=
# Cadena del Session Pooler (puerto 5432) con el driver psycopg:
# postgresql+psycopg://postgres.<PROJECT_REF>:<DB_PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_DATABASE_URL=

# --- MLOps / observabilidad (perfiles opcionales) ---
MLFLOW_TRACKING_URI=
GRAFANA_PASSWORD=cambia-esta-clave
MINIO_ROOT_USER=edumaster
MINIO_ROOT_PASSWORD=cambia-esta-clave

# --- Puertos publicados ---
WEB_PORT=8080
API_PORT=8000
TAG=latest
